# OS
.DS_Store
Thumbs.db

# エディタ
.idea/
.vscode/
*.swp
*~

# 一時ファイル
*.tmp
*.log
__pycache__/
*.pyc
.venv/

# Claude Code のローカル設定（個人用。共有しない）
.claude/settings.local.json

# セッションの揮発状態（ステータスバーのドメイン表示、再開ポインタ、文脈メーター）
.session/

# 秘密情報。絶対にコミットしない。APIキーはローカルの .env にだけ置く
.env
*.env

# 生の取り込み素材（ローカルのみ。境界を守るため）
knowledge/**/_inbox/

# 秘密情報（OAuthクライアント、トークン）。絶対にコミットしない
.secrets/

# 外部から取り込んだ生データ（メール、分析データ）。揮発する情報
data/
