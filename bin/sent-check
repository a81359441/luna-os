#!/usr/bin/env python3
"""backlog の「送る」項目のうち、もう送ってあるものはどれか。

{{AI_NAME}}が下書きを作り、人間が送る（スマホの Gmail や別の窓から）。
そのことを backlog は知らないので、送ったあとも「送信待ち」のまま残り、
ブリーフが毎朝それを今日の仕事として出し続ける。ユーザーの記憶ではなく、
Gmail の送信済みフォルダに聞いてこの輪を閉じる。

開いている項目（[ ] か [~]）に ✉ 行があれば、送信待ちとみなす:

    ✉ to:tanaka@example.co.jp thread:0123456789abcdef since:2026-10-01
    ✉ via:LINE since:2026-09-30          （Gmail 以外。締めでユーザーに聞く）

`jp-email` が下書きを作った時点でこの行を付ける。✉ 行の無い古い項目は、
言い回し（送信待ち、下書き済み、返信を送る など）と宛先から拾い、
スレッドで照合できないので「たぶん」として出す。

    python3 bin/sent-check            一覧
    python3 bin/sent-check --json     bin/menu 用
読むだけで、backlog は書き換えない。見つかったものは締めで片付ける。
"""
import datetime as dt
import importlib.util
import json
import os
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# worktree の中では、gitignore 済みの鍵は本体のチェックアウトにある（bin/gmail/gmail.py と同じ解決）
_git = ROOT / ".git"
HOME = ROOT
if _git.is_file() and _git.read_text(encoding="utf-8").startswith("gitdir:"):
    _gd = (ROOT / _git.read_text(encoding="utf-8")[len("gitdir:"):].strip()).resolve()
    if _gd.parent.name == "worktrees":
        HOME = _gd.parent.parent.parent
TOKEN = Path(os.environ.get("GMAIL_TOKEN", HOME / ".secrets" / "gmail-token.json"))
# 自分のアドレス（宛先として拾わない）。カンマ区切りで設定する。
OWN = {a.strip().lower() for a in os.environ.get("AI_OWN_EMAILS", "").split(",") if a.strip()}

ITEM = re.compile(r"^- \[( |~)\] (.*)")
MARK = re.compile(r"✉\s*(.*)")
PENDING = re.compile(r"送信待ち|本人送信(?!済)|本人が送信(?!済)|下書き済み|下書きに用意|返信を送る|返事を送る|メールを送る")
DONE = re.compile(r"送信済|返信済|送信した|✅")
WORD = re.compile(r"[A-Za-z][A-Za-z0-9]{2,}|[ァ-ヶー]{3,}")
EMAIL = re.compile(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+")
DATE = re.compile(r"20\d\d-\d\d-\d\d")


def backlogs():
    yield ROOT / "tasks" / "backlog.md"
    yield from sorted((ROOT / "knowledge" / "domains").glob("**/backlog.md"))


def items(path: Path):
    """開いている項目ごとに（見出し, 本文の行）。"""
    cur = None
    for line in path.read_text(encoding="utf-8").splitlines():
        m = ITEM.match(line)
        if m:
            if cur:
                yield cur
            cur = (m.group(2), [])
        elif cur and line.startswith((" ", "\t")) and line.strip():
            cur[1].append(line.strip())
        elif cur and (line.startswith(("-", "#")) or not line.strip()):
            yield cur
            cur = None
    if cur:
        yield cur


def gmail():
    os.environ["GMAIL_TOKEN"] = str(TOKEN)
    spec = importlib.util.spec_from_file_location("gm", ROOT / "bin" / "gmail" / "gmail.py")
    gm = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(gm)
    return gm


def sent(gm, to=None, thread=None, since=None, word=None):
    """`since` 以降に、このスレッド／この宛先へユーザーが送った最新のメール。"""
    q = ["in:sent"]
    if to:
        q.append(f"to:{to}")
    if word:
        q.append(f'newer_than:7d "{word}"')
    elif since:
        q.append("after:" + since.replace("-", "/"))
    if thread:
        msgs = gm.get(f"threads/{thread}", format="metadata",
                      metadataHeaders=["Subject", "To", "Date"]).get("messages", [])
        msgs = [m for m in msgs if "SENT" in m.get("labelIds", [])
                and (not since or int(m["internalDate"]) / 1000
                     >= dt.datetime.fromisoformat(since).timestamp())]
    else:
        ids = gm.search_ids(" ".join(q), 3)
        msgs = [gm.get(f"messages/{i}", format="metadata",
                       metadataHeaders=["Subject", "To", "Date"]) for i in ids]
    if not msgs:
        return None
    m = max(msgs, key=lambda x: int(x["internalDate"]))
    h = gm.headers_of(m)
    when = dt.datetime.fromtimestamp(int(m["internalDate"]) / 1000).strftime("%m/%d %H:%M")
    return f"{when} {h.get('subject', '')[:50]}"


def scan():
    found = []
    for path in backlogs():
        if not path.exists():
            continue
        rel = path.relative_to(ROOT)
        for title, body in items(path):
            title_clean = re.sub(r"\*\*", "", title)[:60]
            marks = [MARK.search(l).group(1) for l in [title, *body] if MARK.search(l)]
            if marks:
                for spec in marks:
                    kv = dict(p.split(":", 1) for p in spec.split() if ":" in p)
                    found.append({"file": str(rel), "item": title_clean, "exact": True, **kv})
                continue
            lines = [l for l in [title, *body] if PENDING.search(l) and not DONE.search(l)]
            if not lines:
                continue
            addrs = [a for l in lines for a in EMAIL.findall(l) if a.lower() not in OWN]
            text = " ".join([title, *body])
            dates = sorted(DATE.findall(text))
            since = dates[-1] if dates else None
            word = WORD.search(re.sub(r"[*🔒⏰🔥🏭]", "", title))
            for a in dict.fromkeys(addrs) or [None]:
                found.append({"file": str(rel), "item": title_clean, "exact": False,
                              "to": a, "since": since,
                              "word": None if a or not word else word.group(0)})
    return found


def main():
    as_json = "--json" in sys.argv
    pending = scan()
    gm = gmail() if TOKEN.exists() else None
    for p in pending:
        p["status"] = "ask"
        if p.get("via") or not gm or not (p.get("to") or p.get("thread") or p.get("word")):
            continue
        hit = sent(gm, p.get("to"), p.get("thread"), p.get("since"), p.get("word"))
        p["status"] = "sent" if hit else "unsent"
        p["evidence"] = hit
    if as_json:
        print(json.dumps(pending, ensure_ascii=False))
        return
    label = {"sent": "✔ 送信済", "unsent": "· 未送信", "ask": "? 要確認"}
    if not pending:
        print("送信待ちの項目はありません。")
    for p in sorted(pending, key=lambda x: x["status"] != "sent"):
        how = "" if p["exact"] else "（たぶん: 言い回しで照合）"
        where = p.get("via") or p.get("to") or (f'"{p["word"]}"' if p.get("word") else "宛先なし")
        print(f"{label[p['status']]}  {p['item']}  [{where}]{how}")
        print(f"          {p['file']}" + (f"  ← {p['evidence']}" if p.get("evidence") else ""))
    if not gm:
        print("\n（Gmail のトークンが無いので照合していません: python3 bin/gmail/auth.py）")


if __name__ == "__main__":
    main()
